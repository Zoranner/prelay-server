meta {
  name: 新增供应商
  type: http
  seq: 4
}

post {
  url: {{relay_url}}/api/providers
  body: json
  auth: bearer
}

auth:bearer {
  token: <device-credential>
}

body:json {
  {
    "name": "示例供应商",
    "provider_type": "openai_compatible",
    "base_url": "https://example.invalid/v1",
    "api_key": "<provider-api-key>",
    "models": [
      "example-model"
    ]
  }
}

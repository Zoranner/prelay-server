meta {
  name: 更新接口
  type: http
  seq: 16
}

patch {
  url: {{relay_url}}/api/endpoints/:endpoint_id
  body: json
  auth: bearer
}

auth:bearer {
  token: <device-credential>
}

params:path {
  endpoint_id: <endpoint-id>
}

body:json {
  {
    "name": "更新后的接口名称",
    "models": [
      {
        "provider_id": "<provider-id>",
        "upstream_model": "example-model",
        "model_name": "example-model"
      }
    ]
  }
}

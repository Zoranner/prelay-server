meta {
  name: 创建对话补全
  type: http
  seq: 8
}

post {
  url: {{relay_url}}/v1/chat/completions
  body: json
  auth: bearer
}

auth:bearer {
  token: <endpoint-token>
}

body:json {
  {
    "model": "<endpoint-model-name>",
    "messages": [
      {
        "role": "user",
        "content": "请用一句话回复。"
      }
    ],
    "stream": false
  }
}

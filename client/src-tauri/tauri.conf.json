{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Provider Relay",
  "version": "0.1.0",
  "identifier": "kim.rd.provider-relay",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "Provider Relay",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

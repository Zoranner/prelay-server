# 基础安全
# 必填：用于加密保存供应商密钥的主密钥。
ENCRYPTION_KEY=<BASE64_ENCODED_32_BYTE_KEY>

# 数据库
# 必填：内置 PostgreSQL 服务的主机名为 `postgres`。
# 使用 SQLite 或外部 PostgreSQL 时，替换为实际连接地址。
DATABASE_URL=postgresql://prelay:prelay@postgres:5432/prelay
# 可选：PostgreSQL 最大连接数；SQLite 始终只使用一个连接。
# DATABASE_MAX_CONNECTIONS=10

# 服务运行
# 可选：监听地址，默认值为 0.0.0.0:18080。
# LISTEN_ADDRESS=0.0.0.0:18080
# 可选：日志过滤规则，默认值为 prelay_server=info,tower_http=info。
# RUST_LOG=prelay_server=info,tower_http=info

# 模型与上游调用
# 可选：模型价格文件；存在时默认使用 config/model_prices.json。
# MODEL_PRICES_PATH=/app/config/model_prices.json
# 可选：单次上游调用超时秒数，默认值为 300。
# UPSTREAM_TIMEOUT_SECS=300
# 可选：上游失败后的最大重试次数，默认不重试。
# UPSTREAM_MAX_RETRIES=0
# 可选：两次上游重试之间的等待毫秒数，默认值为 250。
# UPSTREAM_RETRY_BACKOFF_MS=250
# 可选：一次请求最多选择的上游候选供应商数，默认值为 3。
# UPSTREAM_MAX_CANDIDATES=3

# 客户端更新
# 可选：客户端发布仓库，默认值为 Zoranner/prelay-client。
# CLIENT_UPDATE_REPOSITORY=Zoranner/prelay-client
# 可选：服务端缓存客户端安装包的目录，默认值为 /app/updates。
# CLIENT_UPDATE_DIR=/app/updates

# 扩展目录
# 可选：扩展仓库所在的 Gitea 地址，默认值为 https://git.kimo.ink。
# EXTENSIONS_GITEA_URL=https://git.kimo.ink
# 可选：Gitea 中存放扩展仓库的组织，默认值为 agents。
# EXTENSIONS_GITEA_ORGANIZATION=agents
# 可选：读取私有扩展仓库的 Gitea 只读令牌；公开组织保持为空。
# EXTENSIONS_GITEA_READ_TOKEN=
# 可选：扩展目录缓存有效期，单位为秒，默认值为 300。
# EXTENSIONS_CATALOG_CACHE_TTL_SECONDS=300

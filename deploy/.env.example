# Required by prelay-server.
ENCRYPTION_KEY=<BASE64_ENCODED_32_BYTE_KEY>

# Required. The bundled PostgreSQL service is available as `postgres`.
# Replace with a SQLite or external PostgreSQL URL only when using a different deployment.
DATABASE_URL=postgresql://prelay:prelay@postgres:5432/prelay

# Optional network and logging settings. Defaults: 18080 and prelay_server=info,tower_http=info.
# LISTEN_ADDRESS=0.0.0.0:18080
# RUST_LOG=prelay_server=info,tower_http=info

# Optional PostgreSQL connection limit. SQLite always uses one connection.
# DATABASE_MAX_CONNECTIONS=10

# Optional model price file. Defaults to config/model_prices.json when present.
# MODEL_PRICES_PATH=/app/config/model_prices.json

# Optional upstream retry policy. Defaults: 300 seconds, no retries, 250 ms, unlimited candidates.
# UPSTREAM_TIMEOUT_SECS=300
# UPSTREAM_MAX_RETRIES=0
# UPSTREAM_RETRY_BACKOFF_MS=250
# UPSTREAM_MAX_CANDIDATES=3

# Optional client update source. Defaults to Zoranner/prelay-client and /app/updates.
# CLIENT_UPDATE_REPOSITORY=Zoranner/prelay-client
# CLIENT_UPDATE_DIR=/app/updates

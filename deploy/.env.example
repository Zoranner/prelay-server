# Required by prelay-server.
PRELAY_MASTER_KEY=<BASE64_ENCODED_32_BYTE_KEY>

# Choose exactly one fresh SQLite or PostgreSQL deployment.
DATABASE_URL=<SQLITE_OR_POSTGRES_DATABASE_URL>

# Required only by docker-compose.postgres.yml.
POSTGRES_DB=<POSTGRES_DATABASE>
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>

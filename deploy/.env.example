# Released image version. Use a fixed version, not latest.
PRELAY_VERSION=0.1.0

# Required. Generate once and keep this value stable after deployment.
PRELAY_MASTER_KEY=REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_KEY

# Optional runtime settings.
LISTEN_PORT=18080
RUST_LOG=prelay_server=info,tower_http=info
MODEL_PRICES_PATH=config/model_prices.json
